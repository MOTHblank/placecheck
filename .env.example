DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=placecheck
POSTGRES_USER=placecheck
POSTGRES_PASSWORD=placecheck
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=0
# Desenvolvimento interno: não registrar eventos da jornada.
ANALYTICS_EXCLUDE_ALL=1

# Opcional, somente no piloto interno: um ou dois recortes UF:slug-cidade.
# O override docker-compose.ilb-joint.yml configura BA:salvador,SP:campinas.
ILB_PILOT_MARKETS=
# Histórico individual somente no escopo interno aprovado; padrão desligado.
ILB_PILOT_PRICE_HISTORY=0
# O piloto conjunto aprovado habilita por padrão; 0 revoga após repetir setup.
ILB_JOINT_PRICE_HISTORY=1
